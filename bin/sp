#!/bin/sh
# Prefer the project venv (it has pypdf for `sp init --file resume.pdf`).
root="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
if [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" -m smartpaste.cli "$@"
fi
exec python3 -m smartpaste.cli "$@"
